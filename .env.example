# Database (SQLite for prototype — file lives at prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Auth — used to sign session JWTs (any random string for the prototype)
AUTH_SECRET="change-me-to-a-long-random-string"

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-..."

# Optional model overrides (defaults match Section 7).
# Note: Haiku 4.5 on the Anthropic API uses the date-stamped ID below.
CLAUDE_MODEL_OPUS="claude-opus-4-7"
CLAUDE_MODEL_SONNET="claude-sonnet-4-6"
CLAUDE_MODEL_HAIKU="claude-haiku-4-5-20251001"
